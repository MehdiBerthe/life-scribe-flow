## Copy this file to `.env` and fill in the values locally. The `.env` file is git-ignored
## so your Supabase credentials never leave your machine. When you tunnel the component
## app (e.g., with ngrok), update LIFEX_COMPONENT_URL manually or via
## `npm run set:component-url -- https://your-tunnel-url`.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LIFEX_COMPONENT_URL=http://localhost:5174
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
